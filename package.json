{
  "name": "cyber-co-workers",
  "version": "0.1.0",
  "private": true,
  "description": "A living office for your Codex sessions",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts-dev.mjs",
    "build": "tsc --noEmit && vite build && esbuild src/main/index.ts src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist/main",
    "start": "electron .",
    "preview": "vite --host 127.0.0.1",
    "test": "tsx --test src/main/*.test.ts scripts/*.test.ts && node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-packager . 'Cyber Co-workers' --platform=darwin --out=release --overwrite --ignore='^/(src|release|.git|node_modules/.cache)($|/)'",
    "connect": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
